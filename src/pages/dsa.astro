---
import Layout from '../layouts/Layout.astro';

const guides = [
  {
    href: '/dsa/prep.html',
    title: 'Arrays, Two Pointers, Sliding Window, Prefix Sum & Kadane\'s',
    description: 'Muscle-memory drill guide with interactive walkthroughs, templates, and an unseen practice set. Covers 5 core patterns with must-know questions.',
    tags: ['arrays', 'two-pointers', 'sliding-window', 'prefix-sum', "kadane's"],
  },
];
---

<Layout title="DSA — Krishna Chaitanya Vulchi" description="DSA prep guides — patterns, templates, and practice problems.">
  <section class="wrap wrap--wide">
    <p class="eyebrow">dsa</p>
    <h1>DSA prep guides</h1>
    <p class="page-intro">
      Pattern-first study material — interactive walkthroughs, muscle-memory
      templates, and unseen practice problems for each topic.
    </p>
    <div>
      {guides.map((g) => (
        <a class="dsa-card" href={g.href}>
          <span class="dsa-card__title">{g.title}</span>
          <p class="dsa-card__desc">{g.description}</p>
          <div class="dsa-card__tags">
            {g.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  h1 { margin: 10px 0 12px; font-size: 2rem; }
  .page-intro {
    color: var(--ink-dim);
    max-width: 60ch;
    margin-bottom: 32px;
  }
  .dsa-card {
    display: block;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .dsa-card:first-of-type { padding-top: 0; }
  .dsa-card:hover .dsa-card__title { color: var(--amber); }
  .dsa-card__title {
    display: block;
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ink);
  }
  .dsa-card__desc {
    margin: 6px 0 0;
    color: var(--ink-dim);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .dsa-card__tags { margin-top: 10px; }
</style>
